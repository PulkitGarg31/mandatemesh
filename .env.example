# Razorpay TEST keys (Dashboard → Account & Settings → API Keys, Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# LLM: any OpenAI-compatible endpoint. Default = Gemini free tier (no card needed).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-3.8-flash

# Offline alternative (Ollama, already-pulled model):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# Groq free tier alternative:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_key
# LLM_MODEL=openai/gpt-oss-120b

# Per-call LLM timeout in seconds (default 60). Raise for CPU-only Ollama, e.g. 240.
# LLM_TIMEOUT_S=240

# NVIDIA NIM (build.nvidia.com; free developer credits, OpenAI-compatible, tool calling on Llama 3.x / Mistral / Nemotron):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-your_key
# LLM_MODEL=meta/llama-3.3-70b-instruct
